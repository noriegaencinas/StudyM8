# ============================================================
# StudyMate — variables de entorno
# Copia este archivo y rellena los valores. NUNCA subas el .env real.
# ============================================================

# ---------- App móvil (Expo) ----------
# Copiar a app/.env
# Solo las variables con prefijo EXPO_PUBLIC_ llegan a la app y son visibles
# para cualquiera que la instale: no pongas claves secretas aquí.

# URL del backend Flask. En un teléfono físico usa la IP local de tu PC
# (por ejemplo http://192.168.1.50:5000), no "localhost".
EXPO_PUBLIC_API_URL=http://localhost:5000

# ---------- Backend (Flask) ----------
# Copiar a backend/.env

FLASK_ENV=development
FLASK_PORT=5000
# Clave para firmar sesiones/tokens. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto

# Ruta del archivo SQLite
DATABASE_URL=sqlite:///studymate.db

# Proveedor de IA (la clave solo vive en el backend)
AI_PROVIDER=anthropic
AI_API_KEY=tu-clave-aqui
AI_MODEL=claude-sonnet-5-5

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:8081
