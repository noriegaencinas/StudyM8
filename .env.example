# ============================================================
# StudyMate — variables de entorno
# Copia este archivo y rellena los valores. NUNCA subas el .env real.
# ============================================================

# ---------- App móvil (Expo) ----------
# Copiar a app/.env
# Solo las variables con prefijo EXPO_PUBLIC_ llegan a la app y son visibles
# para cualquiera que la instale: no pongas claves secretas aquí.

# URL del backend Flask. Normalmente NO hace falta: si la dejas comentada, la app
# usa automáticamente la IP de la computadora que ejecuta `npm start` y el puerto 5000.
# Defínela solo si el backend corre en otra máquina o puerto, por ejemplo:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:5000

# ---------- Backend (Flask) ----------
# Copiar a backend/.env (si falta, el backend también lee el .env de la raíz)

# 0.0.0.0 permite que el teléfono se conecte por la red local; usa 127.0.0.1
# si solo vas a probar desde la misma computadora.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# 1 = recarga automática y depurador. No lo actives en redes que no sean de confianza.
FLASK_DEBUG=0
# Clave para firmar sesiones/tokens. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto

# Ruta del archivo SQLite
DATABASE_URL=sqlite:///studymate.db

# Proveedor de IA (la clave solo vive en el backend).
# anthropic = API real de Claude; mock = respuestas simuladas sin costo (para desarrollo).
AI_PROVIDER=anthropic
AI_API_KEY=tu-clave-aqui
AI_MODEL=claude-sonnet-5-5

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:8081
